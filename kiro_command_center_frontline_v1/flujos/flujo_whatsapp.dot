digraph WA {
  graph [rankdir=TB, fontname="Arial", nodesep=0.35, ranksep=0.42, pad=0.4, bgcolor="white", label=<<B><FONT POINT-SIZE="20" COLOR="#1F3864">Flujo de solicitud de constancia por WhatsApp</FONT></B>>, labelloc=t];
  node [fontname="Arial", fontsize=11, style="rounded,filled", color="#1F3864", penwidth=1.1, margin="0.2,0.08"];
  edge [fontname="Arial", fontsize=10, color="#404040", arrowsize=0.7];
  ini [label="Colaborador escribe \"constancia\"", shape=oval, style="filled", fillcolor="#1F3864", fontcolor="white"];
  reg [label="¿WhatsApp registrado?", shape=diamond, style="rounded,filled", fillcolor="#FDEBD9"];
  noreg [label="Responder: número no registrado. Fin", shape=box, style="rounded,filled", fillcolor="#F3F4F6"];
  act [label="¿Estatus ACTIVO?", shape=diamond, style="rounded,filled", fillcolor="#FDEBD9"];
  cons [label="¿Consentimiento vigente?", shape=diamond, style="rounded,filled", fillcolor="#FDEBD9"];
  nocons [label="Responder: servicio no disponible (BAJA o consentimiento vencido). Avisar a RH", shape=box, style="rounded,filled", fillcolor="#F3F4F6"];
  otp [label="Enviar código de un solo uso y pedir dato adicional (últimos 4 dígitos del NSS)", shape=box, style="rounded,filled", fillcolor="#E8F0FB"];
  ver [label="¿Verificado?", shape=diamond, style="rounded,filled", fillcolor="#FDEBD9"];
  int [label="¿Menos de 3 intentos?", shape=diamond, style="rounded,filled", fillcolor="#FDEBD9"];
  bloq [label="Bloquear verificación. Notificar a RH", shape=box, style="rounded,filled", fillcolor="#FEE2E2"];
  menu [label="¿Más de una plantilla activa?", shape=diamond, style="rounded,filled", fillcolor="#FDEBD9"];
  lista [label="Mostrar lista de plantillas activas y elegir", shape=box, style="rounded,filled", fillcolor="#E8F0FB"];
  una [label="Usar la plantilla activa única", shape=box, style="rounded,filled", fillcolor="#E8F0FB"];
  falt [label="¿Campos obligatorios completos?", shape=diamond, style="rounded,filled", fillcolor="#FDEBD9"];
  faltn [label="Responder que falta información. Notificar a RH con los campos", shape=box, style="rounded,filled", fillcolor="#FEE2E2"];
  gen [label="Generar PDF con la versión de plantilla y datos actuales", shape=box, style="rounded,filled", fillcolor="#E8F0FB"];
  fol [label="Asignar folio único y guardar snapshot de datos y hash", shape=box, style="rounded,filled", fillcolor="#E8F0FB"];
  env [label="Enviar PDF por WhatsApp", shape=box, style="rounded,filled", fillcolor="#E8F0FB"];
  ent [label="¿Entregado?", shape=diamond, style="rounded,filled", fillcolor="#FDEBD9"];
  fall [label="Marcar FALLIDA y notificar a RH (tras 2 intentos)", shape=box, style="rounded,filled", fillcolor="#FEE2E2"];
  ok [label="Marcar ENTREGADA. Registrar en historial y bitácora", shape=box, style="rounded,filled", fillcolor="#DCFCE7"];
  fin [label="Fin", shape=oval, style="filled", fillcolor="#1F3864", fontcolor="white"];
  ini -> reg;
  reg -> noreg [label="No"];
  reg -> act [label="Sí"];
  act -> nocons [label="No"];
  act -> cons [label="Sí"];
  cons -> nocons [label="No"];
  cons -> otp [label="Sí"];
  otp -> ver;
  ver -> int [label="No"];
  int -> otp [label="Sí"];
  int -> bloq [label="No"];
  ver -> menu [label="Sí"];
  menu -> lista [label="Sí"];
  menu -> una [label="No"];
  lista -> falt;
  una -> falt;
  falt -> faltn [label="No"];
  falt -> gen [label="Sí"];
  gen -> fol;
  fol -> env;
  env -> ent;
  ent -> ok [label="Sí"];
  ent -> fall [label="No"];
  ok -> fin;
  faltn -> fin;
  bloq -> fin;
  nocons -> fin;
  noreg -> fin;
  fall -> fin;
}
