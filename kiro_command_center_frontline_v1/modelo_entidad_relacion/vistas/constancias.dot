graph G {
  graph [fontname="Arial", pad=0.4, bgcolor="white", rankdir=LR, nodesep=0.35, ranksep=1.0, label=<<B><FONT POINT-SIZE="20" COLOR="#1F3864">Constancias · campos clave</FONT></B>>, labelloc=t];
  node [shape=plain, fontname="Arial"];
  edge [fontname="Arial", fontsize=10, color="#6B7280"];
  PLANTILLA_CONSTANCIA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#0F766E"><TR><TD BGCOLOR="#0F766E"><FONT COLOR="white"><B>PLANTILLA CONSTANCIA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Tipo de constancia (laboral, guardería…)</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F9FAFB"><FONT POINT-SIZE="10"><B>id</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nombre</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">activa</FONT></TD></TR></TABLE>>];
  VERSION_PLANTILLA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#0F766E"><TR><TD BGCOLOR="#0F766E"><FONT COLOR="white"><B>VERSION PLANTILLA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Versión publicada de una plantilla</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F9FAFB"><FONT POINT-SIZE="10"><B>id</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">número</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">contenido (S3)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">hash</FONT></TD></TR></TABLE>>];
  CONVERSACION_WHATSAPP [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#0F766E"><TR><TD BGCOLOR="#0F766E"><FONT COLOR="white"><B>CONVERSACION WHATSAPP</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Chat con el colaborador y su verificación</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F9FAFB"><FONT POINT-SIZE="10"><B>id</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">estado</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">intentos</FONT></TD></TR></TABLE>>];
  SOLICITUD_CONSTANCIA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#0F766E"><TR><TD BGCOLOR="#0F766E"><FONT COLOR="white"><B>SOLICITUD CONSTANCIA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Pedido de constancia por WhatsApp</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F9FAFB"><FONT POINT-SIZE="10"><B>id</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">estado</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">fecha</FONT></TD></TR></TABLE>>];
  CONSTANCIA_GENERADA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#0F766E"><TR><TD BGCOLOR="#0F766E"><FONT COLOR="white"><B>CONSTANCIA GENERADA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Constancia emitida con folio y PDF</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F9FAFB"><FONT POINT-SIZE="10"><B>id</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">folio</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PDF (S3)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">estado de entrega</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">datos usados</FONT></TD></TR></TABLE>>];
  COLABORADOR [label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#9CA3AF"><TR><TD BGCOLOR="#E5E7EB"><FONT COLOR="#374151"><B>COLABORADOR</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#6B7280">de Colaboradores</FONT></TD></TR></TABLE>>];
  PLANTILLA_CONSTANCIA -- VERSION_PLANTILLA [label="1 : muchos"];
  COLABORADOR -- CONVERSACION_WHATSAPP [label="1 : muchos"];
  CONVERSACION_WHATSAPP -- SOLICITUD_CONSTANCIA [label="1 : muchos"];
  COLABORADOR -- SOLICITUD_CONSTANCIA [label="1 : muchos"];
  VERSION_PLANTILLA -- SOLICITUD_CONSTANCIA [label="0..1 : muchos"];
  SOLICITUD_CONSTANCIA -- CONSTANCIA_GENERADA [label="1 : 0..1"];
  VERSION_PLANTILLA -- CONSTANCIA_GENERADA [label="1 : muchos"];
  COLABORADOR -- CONSTANCIA_GENERADA [label="1 : muchos"];
}
