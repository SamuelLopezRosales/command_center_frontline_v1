graph G {
  graph [fontname="Arial", pad=0.4, bgcolor="white", rankdir=LR, nodesep=0.35, ranksep=1.0, label=<<B><FONT POINT-SIZE="20" COLOR="#1F3864">Colaboradores · campos clave</FONT></B>>, labelloc=t];
  node [shape=plain, fontname="Arial"];
  edge [fontname="Arial", fontsize=10, color="#6B7280"];
  ORGANIZACION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1F3864"><TR><TD BGCOLOR="#1F3864"><FONT COLOR="white"><B>ORGANIZACION</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Razón social con su RFC y firmante</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F9FAFB"><FONT POINT-SIZE="10"><B>id</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">clave</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">razón social</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">RFC</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ciudad</FONT></TD></TR></TABLE>>];
  PLANTA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1F3864"><TR><TD BGCOLOR="#1F3864"><FONT COLOR="white"><B>PLANTA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Centro de trabajo del colaborador</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F9FAFB"><FONT POINT-SIZE="10"><B>id</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nombre</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">activa</FONT></TD></TR></TABLE>>];
  COLABORADOR [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1F3864"><TR><TD BGCOLOR="#1F3864"><FONT COLOR="white"><B>COLABORADOR</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Persona con número de empleado y WhatsApp</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F9FAFB"><FONT POINT-SIZE="10"><B>id</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">número de empleado</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nombres y apellidos</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">estatus</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">consentimiento</FONT></TD></TR></TABLE>>];
  CAMPO_COLABORADOR [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1F3864"><TR><TD BGCOLOR="#1F3864"><FONT COLOR="white"><B>CAMPO COLABORADOR</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Dato adicional que RH decide capturar</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F9FAFB"><FONT POINT-SIZE="10"><B>id</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nombre visible</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">clave de variable</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">tipo de dato</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">sensible</FONT></TD></TR></TABLE>>];
  OPCION_CAMPO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1F3864"><TR><TD BGCOLOR="#1F3864"><FONT COLOR="white"><B>OPCION CAMPO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Opción de una lista (área, turno…)</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F9FAFB"><FONT POINT-SIZE="10"><B>id</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">etiqueta</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">descripción</FONT></TD></TR></TABLE>>];
  VALOR_CAMPO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1F3864"><TR><TD BGCOLOR="#1F3864"><FONT COLOR="white"><B>VALOR CAMPO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Valor de un campo para un colaborador</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F9FAFB"><FONT POINT-SIZE="10"><B>id</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">valor</FONT></TD></TR></TABLE>>];
  CARGA_COLABORADORES [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1F3864"><TR><TD BGCOLOR="#1F3864"><FONT COLOR="white"><B>CARGA COLABORADORES</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Archivo de carga masiva de Excel</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F9FAFB"><FONT POINT-SIZE="10"><B>id</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">archivo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">filas con error</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">estado</FONT></TD></TR></TABLE>>];
  FILA_CARGA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1F3864"><TR><TD BGCOLOR="#1F3864"><FONT COLOR="white"><B>FILA CARGA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Resultado de cada fila cargada</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F9FAFB"><FONT POINT-SIZE="10"><B>id</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">fila</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">resultado</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">mensaje</FONT></TD></TR></TABLE>>];
  ORGANIZACION -- COLABORADOR [label="1 : muchos"];
  PLANTA -- COLABORADOR [label="1 : muchos"];
  CAMPO_COLABORADOR -- OPCION_CAMPO [label="1 : muchos"];
  CAMPO_COLABORADOR -- VALOR_CAMPO [label="1 : muchos"];
  COLABORADOR -- VALOR_CAMPO [label="1 : muchos"];
  OPCION_CAMPO -- VALOR_CAMPO [label="0..1 : muchos"];
  CARGA_COLABORADORES -- FILA_CARGA [label="1 : muchos"];
  COLABORADOR -- FILA_CARGA [label="0..1 : muchos"];
}
