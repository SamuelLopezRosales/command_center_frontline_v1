graph G {
  graph [fontname="Arial", pad=0.4, bgcolor="white", rankdir=LR, nodesep=0.35, ranksep=1.0, label=<<B><FONT POINT-SIZE="20" COLOR="#1F3864">Notificaciones · campos clave</FONT></B>>, labelloc=t];
  node [shape=plain, fontname="Arial"];
  edge [fontname="Arial", fontsize=10, color="#6B7280"];
  PLANTILLA_MENSAJE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#2E7D5B"><TR><TD BGCOLOR="#2E7D5B"><FONT COLOR="white"><B>PLANTILLA MENSAJE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Plantilla de WhatsApp aprobada por Meta</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F9FAFB"><FONT POINT-SIZE="10"><B>id</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nombre</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">estado en Meta</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">texto</FONT></TD></TR></TABLE>>];
  AUDIENCIA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#2E7D5B"><TR><TD BGCOLOR="#2E7D5B"><FONT COLOR="white"><B>AUDIENCIA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Grupo guardado por criterios</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F9FAFB"><FONT POINT-SIZE="10"><B>id</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nombre</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">criterios</FONT></TD></TR></TABLE>>];
  NOTIFICACION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#2E7D5B"><TR><TD BGCOLOR="#2E7D5B"><FONT COLOR="white"><B>NOTIFICACION</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Envío de un mensaje a un grupo</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F9FAFB"><FONT POINT-SIZE="10"><B>id</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">canal</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">estado</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">programada para</FONT></TD></TR></TABLE>>];
  NOTIFICACION_DESTINATARIO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#2E7D5B"><TR><TD BGCOLOR="#2E7D5B"><FONT COLOR="white"><B>NOTIFICACION DESTINATARIO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Estado del envío para cada colaborador</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F9FAFB"><FONT POINT-SIZE="10"><B>id</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">estado de envío</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">motivo de exclusión</FONT></TD></TR></TABLE>>];
  COLABORADOR [label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#9CA3AF"><TR><TD BGCOLOR="#E5E7EB"><FONT COLOR="#374151"><B>COLABORADOR</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#6B7280">de Colaboradores</FONT></TD></TR></TABLE>>];
  CONVERSACION_WHATSAPP [label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#9CA3AF"><TR><TD BGCOLOR="#E5E7EB"><FONT COLOR="#374151"><B>CONVERSACION_WHATSAPP</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#6B7280">de Constancias</FONT></TD></TR></TABLE>>];
  AUDIENCIA -- NOTIFICACION [label="0..1 : muchos"];
  PLANTILLA_MENSAJE -- NOTIFICACION [label="0..1 : muchos"];
  NOTIFICACION -- NOTIFICACION_DESTINATARIO [label="1 : muchos"];
  COLABORADOR -- NOTIFICACION_DESTINATARIO [label="1 : muchos"];
  CONVERSACION_WHATSAPP -- NOTIFICACION_DESTINATARIO [label="0..1 : muchos"];
}
