graph G {
  graph [fontname="Arial", pad=0.4, bgcolor="white", rankdir=LR, nodesep=0.35, ranksep=1.0, label=<<B><FONT POINT-SIZE="20" COLOR="#1F3864">command-center-v1 · Vista general (sin atributos)
No incluye EMPRESA, USUARIO ni BITÁCORA, que aplican a todas las tablas</FONT></B>>, labelloc=t];
  node [shape=plain, fontname="Arial"];
  edge [fontname="Arial", fontsize=10, color="#6B7280"];
  subgraph cluster_0 { label=<<B><FONT COLOR="#1F3864">Colaboradores</FONT></B>>; style="rounded"; color="#1F3864"; penwidth=1.2;
  ORGANIZACION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1F3864"><TR><TD BGCOLOR="#1F3864"><FONT COLOR="white"><B>ORGANIZACION</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Razón social con su RFC y firmante</I></FONT></TD></TR></TABLE>>];
  PLANTA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1F3864"><TR><TD BGCOLOR="#1F3864"><FONT COLOR="white"><B>PLANTA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Centro de trabajo del colaborador</I></FONT></TD></TR></TABLE>>];
  COLABORADOR [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1F3864"><TR><TD BGCOLOR="#1F3864"><FONT COLOR="white"><B>COLABORADOR</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Persona con número de empleado y WhatsApp</I></FONT></TD></TR></TABLE>>];
  CAMPO_COLABORADOR [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1F3864"><TR><TD BGCOLOR="#1F3864"><FONT COLOR="white"><B>CAMPO COLABORADOR</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Dato adicional que RH decide capturar</I></FONT></TD></TR></TABLE>>];
  OPCION_CAMPO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1F3864"><TR><TD BGCOLOR="#1F3864"><FONT COLOR="white"><B>OPCION CAMPO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Opción de una lista (área, turno…)</I></FONT></TD></TR></TABLE>>];
  VALOR_CAMPO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1F3864"><TR><TD BGCOLOR="#1F3864"><FONT COLOR="white"><B>VALOR CAMPO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Valor de un campo para un colaborador</I></FONT></TD></TR></TABLE>>];
  CARGA_COLABORADORES [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1F3864"><TR><TD BGCOLOR="#1F3864"><FONT COLOR="white"><B>CARGA COLABORADORES</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Archivo de carga masiva de Excel</I></FONT></TD></TR></TABLE>>];
  FILA_CARGA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1F3864"><TR><TD BGCOLOR="#1F3864"><FONT COLOR="white"><B>FILA CARGA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Resultado de cada fila cargada</I></FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_1 { label=<<B><FONT COLOR="#0F766E">Constancias</FONT></B>>; style="rounded"; color="#0F766E"; penwidth=1.2;
  PLANTILLA_CONSTANCIA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#0F766E"><TR><TD BGCOLOR="#0F766E"><FONT COLOR="white"><B>PLANTILLA CONSTANCIA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Tipo de constancia (laboral, guardería…)</I></FONT></TD></TR></TABLE>>];
  VERSION_PLANTILLA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#0F766E"><TR><TD BGCOLOR="#0F766E"><FONT COLOR="white"><B>VERSION PLANTILLA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Versión publicada de una plantilla</I></FONT></TD></TR></TABLE>>];
  CONVERSACION_WHATSAPP [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#0F766E"><TR><TD BGCOLOR="#0F766E"><FONT COLOR="white"><B>CONVERSACION WHATSAPP</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Chat con el colaborador y su verificación</I></FONT></TD></TR></TABLE>>];
  SOLICITUD_CONSTANCIA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#0F766E"><TR><TD BGCOLOR="#0F766E"><FONT COLOR="white"><B>SOLICITUD CONSTANCIA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Pedido de constancia por WhatsApp</I></FONT></TD></TR></TABLE>>];
  CONSTANCIA_GENERADA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#0F766E"><TR><TD BGCOLOR="#0F766E"><FONT COLOR="white"><B>CONSTANCIA GENERADA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Constancia emitida con folio y PDF</I></FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_2 { label=<<B><FONT COLOR="#2E7D5B">Notificaciones</FONT></B>>; style="rounded"; color="#2E7D5B"; penwidth=1.2;
  PLANTILLA_MENSAJE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#2E7D5B"><TR><TD BGCOLOR="#2E7D5B"><FONT COLOR="white"><B>PLANTILLA MENSAJE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Plantilla de WhatsApp aprobada por Meta</I></FONT></TD></TR></TABLE>>];
  AUDIENCIA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#2E7D5B"><TR><TD BGCOLOR="#2E7D5B"><FONT COLOR="white"><B>AUDIENCIA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Grupo guardado por criterios</I></FONT></TD></TR></TABLE>>];
  NOTIFICACION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#2E7D5B"><TR><TD BGCOLOR="#2E7D5B"><FONT COLOR="white"><B>NOTIFICACION</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Envío de un mensaje a un grupo</I></FONT></TD></TR></TABLE>>];
  NOTIFICACION_DESTINATARIO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#2E7D5B"><TR><TD BGCOLOR="#2E7D5B"><FONT COLOR="white"><B>NOTIFICACION DESTINATARIO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#4B5563"><I>Estado del envío para cada colaborador</I></FONT></TD></TR></TABLE>>];
  }
  ORGANIZACION -- COLABORADOR;
  PLANTA -- COLABORADOR;
  CAMPO_COLABORADOR -- OPCION_CAMPO;
  CAMPO_COLABORADOR -- VALOR_CAMPO;
  COLABORADOR -- VALOR_CAMPO;
  OPCION_CAMPO -- VALOR_CAMPO;
  CARGA_COLABORADORES -- FILA_CARGA;
  COLABORADOR -- FILA_CARGA;
  PLANTILLA_CONSTANCIA -- VERSION_PLANTILLA;
  COLABORADOR -- CONVERSACION_WHATSAPP;
  COLABORADOR -- SOLICITUD_CONSTANCIA;
  CONVERSACION_WHATSAPP -- SOLICITUD_CONSTANCIA;
  VERSION_PLANTILLA -- SOLICITUD_CONSTANCIA;
  SOLICITUD_CONSTANCIA -- CONSTANCIA_GENERADA;
  VERSION_PLANTILLA -- CONSTANCIA_GENERADA;
  COLABORADOR -- CONSTANCIA_GENERADA;
  AUDIENCIA -- NOTIFICACION;
  PLANTILLA_MENSAJE -- NOTIFICACION;
  NOTIFICACION -- NOTIFICACION_DESTINATARIO;
  COLABORADOR -- NOTIFICACION_DESTINATARIO;
  CONVERSACION_WHATSAPP -- NOTIFICACION_DESTINATARIO;
}
