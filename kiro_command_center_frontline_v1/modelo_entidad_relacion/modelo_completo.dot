  VALOR_CAMPO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#B5651D"><TR><TD BGCOLOR="#B5651D" COLSPAN="2"><FONT COLOR="white"><B>VALOR_CAMPO</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> colaborador_id</TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> campo_id</TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT">valor_texto / valor_numero</TD><TD ALIGN="LEFT">texto / numero</TD></TR><TR><TD ALIGN="LEFT">valor_fecha</TD><TD ALIGN="LEFT">fecha</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> valor_opcion_id</TD><TD ALIGN="LEFT">int (opcional)</TD></TR></TABLE>>];

  CARGA_COLABORADORES [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F3864"><TR><TD BGCOLOR="#1F3864" COLSPAN="2"><FONT COLOR="white"><B>CARGA_COLABORADORES</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> empresa_id</TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> usuario_id</TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT">nombre_archivo / version_plantilla</TD><TD ALIGN="LEFT">texto</TD></TR><TR><TD ALIGN="LEFT">hash_archivo</TD><TD ALIGN="LEFT">texto</TD></TR><TR><TD ALIGN="LEFT">total_filas / filas_ok / filas_error</TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT">EN_PROCESO | TERMINADA | CANCELADA</TD></TR><TR><TD ALIGN="LEFT">fecha_carga</TD><TD ALIGN="LEFT">datetime</TD></TR></TABLE>>];

