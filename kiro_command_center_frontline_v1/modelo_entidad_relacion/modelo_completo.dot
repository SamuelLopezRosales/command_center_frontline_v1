graph ER {
  graph [rankdir=LR, splines=true, nodesep=0.45, ranksep=1.4, fontname="Arial", pad=0.4, bgcolor="white", label=<<B><FONT POINT-SIZE="22" COLOR="#1F3864">command-center-v1 — Modelo entidad-relación</FONT></B>>, labelloc=t];
  node [shape=plain, fontname="Arial", fontsize=11];
  edge [fontname="Arial", fontsize=10, color="#404040"];
  EMPRESA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F3864"><TR><TD BGCOLOR="#1F3864" COLSPAN="2"><FONT COLOR="white"><B>EMPRESA</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT">razon_social</TD><TD ALIGN="LEFT">texto</TD></TR><TR><TD ALIGN="LEFT">rfc</TD><TD ALIGN="LEFT">texto</TD></TR><TR><TD ALIGN="LEFT">activa</TD><TD ALIGN="LEFT">boolean</TD></TR></TABLE>>];

  USUARIO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F3864"><TR><TD BGCOLOR="#1F3864" COLSPAN="2"><FONT COLOR="white"><B>USUARIO</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> empresa_id</TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT">texto</TD></TR><TR><TD ALIGN="LEFT">correo</TD><TD ALIGN="LEFT">texto (UK)</TD></TR><TR><TD ALIGN="LEFT">cognito_sub (UK)</TD><TD ALIGN="LEFT">texto</TD></TR><TR><TD ALIGN="LEFT">activo</TD><TD ALIGN="LEFT">boolean</TD></TR></TABLE>>];

  ORGANIZACION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F3864"><TR><TD BGCOLOR="#1F3864" COLSPAN="2"><FONT COLOR="white"><B>ORGANIZACION</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> empresa_id</TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT">clave (UK por empresa)</TD><TD ALIGN="LEFT">texto</TD></TR><TR><TD ALIGN="LEFT">razon_social / rfc</TD><TD ALIGN="LEFT">texto</TD></TR><TR><TD ALIGN="LEFT">registro_patronal / domicilio_fiscal</TD><TD ALIGN="LEFT">texto</TD></TR><TR><TD ALIGN="LEFT">ciudad / registro_patronal</TD><TD ALIGN="LEFT">texto</TD></TR><TR><TD ALIGN="LEFT">logotipo_s3_key</TD><TD ALIGN="LEFT">texto (opcional)</TD></TR><TR><TD ALIGN="LEFT">nombre_firmante / cargo_firmante</TD><TD ALIGN="LEFT">texto</TD></TR><TR><TD ALIGN="LEFT">correo_firmante / activa</TD><TD ALIGN="LEFT">texto / boolean</TD></TR></TABLE>>];

  PLANTA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F3864"><TR><TD BGCOLOR="#1F3864" COLSPAN="2"><FONT COLOR="white"><B>PLANTA</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> empresa_id</TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT">texto</TD></TR><TR><TD ALIGN="LEFT">activa</TD><TD ALIGN="LEFT">boolean</TD></TR></TABLE>>];

  COLABORADOR [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1F3864"><TR><TD BGCOLOR="#1F3864" COLSPAN="2"><FONT COLOR="white"><B>COLABORADOR</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> empresa_id</TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> organizacion_id</TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> planta_id</TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT">numero_empleado (UK por empresa)</TD><TD ALIGN="LEFT">texto</TD></TR><TR><TD ALIGN="LEFT">nombres / apellido_paterno / apellido_materno</TD><TD ALIGN="LEFT">texto</TD></TR><TR><TD ALIGN="LEFT">celular_cifrado / celular_hash</TD><TD ALIGN="LEFT">texto</TD></TR><TR><TD ALIGN="LEFT">fecha_ingreso / puesto</TD><TD ALIGN="LEFT">fecha / texto</TD></TR><TR><TD ALIGN="LEFT">tipo_empleado</TD><TD ALIGN="LEFT">ADMINISTRATIVO | OPERATIVO</TD></TR><TR><TD ALIGN="LEFT">estatus</TD><TD ALIGN="LEFT">ACTIVO | BAJA</TD></TR><TR><TD ALIGN="LEFT">consentimiento_whatsapp</TD><TD ALIGN="LEFT">boolean</TD></TR></TABLE>>];

